---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOCALES, path, type Locale } from '@/i18n/locales';
import { useUI } from '@/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useUI(locale);
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} title={`404 — ${t('site.title')}`} description={t('notfound.text')}>
  <section class="center nf">
    <p class="nf__code">404</p>
    <h1>{t('notfound.title')}</h1>
    <p class="nf__text">{t('notfound.text')}</p>
    <div class="cluster">
      <a class="btn btn--primary" href={path(base, locale)}>{t('common.backHome')}</a>
      <a class="btn" href={path(base, locale, 'case')}>{t('nav.case')} →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-9);
    text-align: center;
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--step-5);
    font-weight: 700;
    color: var(--line-2);
  }
  .nf__text {
    margin-block: var(--space-3) var(--space-5);
    color: var(--ink-3);
  }
  .nf .cluster {
    justify-content: center;
  }
</style>
