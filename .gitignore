# ── 构建产物 ──────────────────────────────────────────────────────────
# 都能由 `npm run build` 重新生成，没有任何理由进仓库
dist/
.astro/
coverage/

# ── 依赖与包管理器缓存 ────────────────────────────────────────────────
# .pnpm-store / .pnpm-cache 是本项目 .npmrc 指定的本地仓库位置，
# 加起来 300MB 上下，且完全可由 pnpm-lock.yaml 重建
node_modules/
.pnpm-store/
.pnpm-cache/
.npm/

# ── 参考样例（第三方页面存档） ────────────────────────────────────────
# 项目启动时用来对照信息组织方式的一份「另存为」网页，含他人站点的
# CSS/JS 资源。它不是本项目的源码，也不适合随本仓库分发。
# 需要保留时，把下面两行删掉即可。
第 1 章*
*_files/

# ── 本地环境 ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.log
*.local

# ── 编辑器与操作系统 ──────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
